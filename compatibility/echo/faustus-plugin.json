{
  "schema": 1,
  "id": "echo",
  "name": "Echo's Hoard · Talos",
  "purpose": "Absorbed by Talos's Hoard. Compatibility identity only; no standalone server. Everything the user copies, kept on their own PC, searchable, with frequent copies pinned; the assistant can search the clipboard history and set the clipboard.",
  "capabilities": [
    "clipboard-history",
    "search",
    "pin",
    "sensitive-detection",
    "images"
  ],
  "placeholders": [
    "TALOS_DIR",
    "APP_URL",
    "TOKEN_FILE",
    "PYTHON"
  ],
  "defaults": {
    "APP_URL": "http://127.0.0.1:5220/clipboard",
    "TOKEN_FILE": "{TALOS_DIR}/data/native/clipboard/data/mcp-token",
    "PYTHON": "{TALOS_DIR}/.venv/Scripts/python.exe",
    "TALOS_DIR": "{COMPAT_DIR}/../..",
    "DATA_DIR": "{TALOS_DIR}/data/native/clipboard/data"
  },
  "app": {
    "url_default": "http://127.0.0.1:5220/clipboard",
    "ui_url": "http://127.0.0.1:5220/",
    "health": {
      "path": "/api/health",
      "expect": {
        "service": "absorbed-echo"
      }
    },
    "identify": {
      "service": [
        "echo-hoard"
      ],
      "title": [
        "echo's hoard",
        "portapapeles"
      ]
    }
  },
  "mcp": {
    "transport": "stdio",
    "command": "{PYTHON}",
    "args": [
      "{TALOS_DIR}/compatibility/mcp_server.py"
    ],
    "env": {
      "HOARD_COMPAT_ID": "echo",
      "HOARD_COMPAT_URL": "http://127.0.0.1:5220"
    },
    "optional_env": []
  },
  "x-family": {
    "copilot": true,
    "absorbed_by": {
      "id": "talos",
      "repository": "https://github.com/Luissalet/TalosHoard",
      "module": "clipboard",
      "standalone": false
    },
    "standalone": false,
    "compatibility": true,
    "source_data": "Moved into the merged application; no dependency on the retired repository."
  },
  "notes": "Native compatibility identity owned by Talos's Hoard. Data, tokens and all runtime files belong to the merged application. No retired repository is required. Start the owner explicitly and enable its module."
}
