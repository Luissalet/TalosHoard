                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Restart automatically when it goes down (opt-in).",
                  "title": "Enabled"
                },
                "cmd": {
                  "anyOf": [
                    {
                      "type": "string"
