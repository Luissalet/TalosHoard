  "tools": [
    {
      "schema": {
        "name": "svc_status",
        "description": "Is it up? Live status of every local AI service and app / ¿Está caído? Estado actual de servicios\nOne service or all: state (up, degraded, foreign, down, never_seen), since when, latency, pid, uptime, open incident, restart policy. Includes machine boot time and GPUs now.\nSinónimos: estado, caído, funciona, arriba, abajo, servicio, puerto, Faustus, Ollama, llama-server, ComfyUI, hub, app.",
        "annotations": {
          "readOnlyHint": true,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "properties": {
            "service": {
              "anyOf": [
                {
                  "maxLength": 120,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Service id, name or port (e.g. 'faustus', 'Argus', '8081'); omit for every service.",
              "title": "Service"
            }
          },
          "title": "StatusArgs",
          "type": "object"
        }
      },
      "module": "services",
      "token_file": "data/native/services/data/mcp-token"
    },
    {
      "schema": {
        "name": "svc_incidents",
        "description": "Incidents (service down, restarted) in a time window / Incidencias y caídas en un intervalo de tiempo\nFilter by since/until or at='04:00' ± window_min, by service, or only open ones. Each has the probable cause and what else changed. Also lists reboots and periods when Cassandra itself was not running.\nSinónimos: qué pasó, caídas, incidencias, anoche, a las 4, se paró todo, cortes, historial.",
        "annotations": {
          "readOnlyHint": true,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "properties": {
            "since": {
              "anyOf": [
                {
                  "maxLength": 40,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Start: ISO time, clock time ('03:50') or age ('2h'). Default 24 h ago.",
              "title": "Since"
            },
            "until": {
              "anyOf": [
                {
                  "maxLength": 40,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "End (same formats). Default now.",
              "title": "Until"
            },
            "at": {
              "anyOf": [
                {
                  "maxLength": 40,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Centre of a window instead of since/until, e.g. '04:00'.",
              "title": "At"
            },
            "window_min": {
              "default": 15,
              "description": "Half-width of the `at` window in minutes.",
              "maximum": 1440,
              "minimum": 1,
              "title": "Window Min",
              "type": "number"
            },
            "service": {
              "anyOf": [
                {
                  "maxLength": 120,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Only this service (id, name or port).",
              "title": "Service"
            },
            "open_only": {
              "default": false,
              "description": "Only incidents that are still open (service still down).",
              "title": "Open Only",
              "type": "boolean"
            },
            "limit": {
              "default": 20,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          "title": "IncidentsArgs",
          "type": "object"
        }
      },
      "module": "services",
      "token_file": "data/native/services/data/mcp-token"
    },
    {
      "schema": {
        "name": "svc_why_down",
        "description": "Why did a service stop? Latest incident explained with its cause / ¿Por qué se paró? Causa probable\nPlain sentences: when it fell, for how long, probable cause (reboot, sleep, several services at once, VRAM contention, Traceback in the log, process gone or hung), GPUs just before, last log lines, restart attempts.\nSinónimos: por qué, causa, motivo, se cayó, se paró, crash, error, explicación.",
        "annotations": {
          "readOnlyHint": true,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "properties": {
            "service": {
              "description": "Service id, name or port.",
              "maxLength": 120,
              "minLength": 1,
              "title": "Service",
              "type": "string"
            },
            "incident_id": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "A specific incident instead of the latest one.",
              "title": "Incident Id"
            }
          },
          "required": [
            "service"
          ],
          "title": "WhyArgs",
          "type": "object"
        }
      },
      "module": "services",
      "token_file": "data/native/services/data/mcp-token"
    },
