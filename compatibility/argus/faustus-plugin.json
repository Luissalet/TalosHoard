{
  "schema": 1,
  "id": "argus",
  "name": "Argus's Hoard · Talos",
  "purpose": "Absorbed by Talos's Hoard. Compatibility identity only; no standalone server. Private screen memory: periodic screenshots of the user's own PC, OCR'd and searchable by text, app, window and time, stored only on the machine.",
  "capabilities": [
    "screen-history",
    "screenshot-import",
    "screenshot-folder-watch",
    "imported-screenshots",
    "ocr",
    "timeline",
    "full-text-search",
    "visual-search",
    "similar-frames",
    "activity-by-app",
    "recent-screen",
    "pause",
    "private-mode",
    "exclusions",
    "retention",
    "delete-range"
  ],
  "placeholders": [
    "TALOS_DIR",
    "APP_URL",
    "TOKEN_FILE",
    "PYTHON"
  ],
  "defaults": {
    "APP_URL": "http://127.0.0.1:5220/screen",
    "TOKEN_FILE": "{TALOS_DIR}/data/native/screen/data/mcp-token",
    "PYTHON": "{TALOS_DIR}/.venv/Scripts/python.exe",
    "TALOS_DIR": "{COMPAT_DIR}/../..",
    "DATA_DIR": "{TALOS_DIR}/data/native/screen/data"
  },
  "app": {
    "url_default": "http://127.0.0.1:5220/screen",
    "ui_url": "http://127.0.0.1:5220/",
    "health": {
      "path": "/api/health",
      "expect": {
        "service": "absorbed-argus"
      }
    },
    "identify": {
      "service": [
        "argus-hoard"
      ],
      "title": [
        "argus's hoard",
        "memoria de pantalla"
      ]
    }
  },
  "mcp": {
    "transport": "stdio",
    "command": "{PYTHON}",
    "args": [
      "{TALOS_DIR}/compatibility/mcp_server.py"
    ],
    "env": {
      "HOARD_COMPAT_ID": "argus",
      "HOARD_COMPAT_URL": "http://127.0.0.1:5220"
    },
    "optional_env": []
  },
  "notes": "Native compatibility identity owned by Talos's Hoard. Data, tokens and all runtime files belong to the merged application. No retired repository is required. Start the owner explicitly and enable its module.",
  "x-family": {
    "copilot": {
      "provider": "faustus",
      "contract": "1.0",
      "panel": "/api/copilot/panel.js",
      "context": [
        "frame",
        "session",
        "day",
        "search",
        "similar_search",
        "period",
        "settings",
        "exclusion",
        "editor"
      ]
    },
    "absorbed_by": {
      "id": "talos",
      "repository": "https://github.com/Luissalet/TalosHoard",
      "module": "screen",
      "standalone": false
    },
    "standalone": false,
    "compatibility": true,
    "source_data": "Moved into the merged application; no dependency on the retired repository."
  }
}
