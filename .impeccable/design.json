      "html": "<button type=\"button\" class=\"ds-switch\" role=\"switch\" aria-label=\"Pantalla\" aria-checked=\"false\"><span>Desactivada</span><span class=\"ds-track\" aria-hidden=\"true\"><span class=\"ds-thumb\"></span></span></button>",
      "css": ".ds-switch{display:flex;gap:10px;align-items:center;border:0;padding:8px 0 8px 8px;min-height:44px;background:transparent;color:var(--hoard-text-muted);font-family:var(--hoard-font-sans);font-size:13px;cursor:pointer}.ds-track{width:42px;height:24px;border-radius:14px;background:var(--hoard-border);padding:3px;flex:none}.ds-thumb{display:block;width:18px;height:18px;border-radius:50%;background:var(--hoard-text);transition:transform .16s ease-out}.ds-switch[aria-checked=true]{color:var(--hoard-accent)}.ds-switch[aria-checked=true] .ds-track{background:var(--hoard-accent)}.ds-switch[aria-checked=true] .ds-thumb{background:var(--hoard-accent-ink);transform:translateX(18px)}.ds-switch:disabled{opacity:.55;cursor:default}.ds-switch:focus-visible{outline:3px solid var(--hoard-accent);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-thumb{transition:none}}"
