  "narrative": {
    "northStar": "The Hoard Workbench",
    "overview": "Talos’s Hoard extends the established Hoard family: tinted charcoal, bronze accents, local Cinzel lettering and Source Sans 3 working text. The family identity sits in the product mark, restrained navigation and explicit control states.\n\nThis record describes the implemented Functions shell in `talos_hoard/web` and the shared return bar injected into native module pages. The shell presents Pantalla, Portapapeles, Actividad, Audio, Servicios and Disco. Native pages retain their own task-specific compositions; this document does not certify every inherited interface or impose the Functions layout on them.",
    "keyCharacteristics": [
      "Tinted charcoal surfaces with one product accent.",
      "Serif identity and page heading; sans-serif working controls.",
      "Flat module rows, adjacent state labels and switches.",
      "Native module compositions remain independent of the shared shell."
    ],
    "rules": [
      {
        "name": "The Product Accent Rule",
        "body": "Use the product accent for identity, active navigation, enabled switches and links; use the charcoal ladder for structure.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Cinzel identifies the product and Functions page; Source Sans 3 carries module names, descriptions, navigation and controls.",
        "section": "typography"
      },
      {
        "name": "The Native Composition Rule",
        "body": "Share the product palette and return bar across modules while preserving each native task layout.",
        "section": "layout"
      },
      {
        "name": "The Flat Rows Rule",
        "body": "Separate Functions modules with borders and space; the shell does not turn each row into a raised card.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the local Cinzel and Source Sans 3 font assets and the family product icon.",
      "Do keep the visible state label adjacent to its switch and return focus to that switch after the refresh.",
      "Do let data-location paths wrap inside their disclosure.",
      "Do retain the standard Faustus launcher supplied by the shared copilot endpoint.",
      "Do preserve native module layouts when applying the common product palette and return bar."
    ],
    "donts": [
      "Don't replace the family dragon/domain asset or the standard Faustus control with a text glyph.",
      "Don't use a raised card for every Functions row; retain the observed flat separators.",
      "Don't infer one common composition for all inherited modules from this shell.",
      "Don't use the generic theme's fallback accent-soft, accent-line or accent-rgb values as product-specific tokens; the current product override does not define them."
    ]
  }
}
